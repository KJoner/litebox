# 构建产物
/bin/
/litebox
/litebox.exe
web/dist/

# 运行时数据
*.db
*.db-wal
*.db-shm
/data/
*.log

# Phase 0 验证产物(体积大,不入库)
/phase0/bin/
/phase0/statsprobe/statsprobe.exe
/phase0/mieruprobe/mieruprobe*
/phase0/logs/

# 要分发到节点的 sing-box 二进制(约 28MB,由 scripts/build-singbox.sh 生成)
assets/singbox/sing-box-linux-*
assets/singbox/sing-box-preview-linux-*
# 构建元数据也是产物,两支各写各的(build-metadata-stable/preview.json)
assets/singbox/build-metadata*.json

# mieru / mita 的官方二进制(各约 13MB,由 scripts/fetch-mieru.sh 拉取)
assets/mieru/mita-linux-*
assets/mieru/mieru-linux-*
.build/

# 依赖
node_modules/

# 前端回归测试的产物(截图基线 e2e/__screenshots__ 要提交,这些不要)
web/test-results/
web/playwright-report/
web/e2e/fixtures/raw*.json
# 脱敏脚本的真实端口 / 别名对照表,只留在本机
web/e2e/tools/sanitize.local.json

# 本地配置(含主密钥,绝不能提交)
litebox.local.yaml
*.local.yaml
.env

# IDE
.idea/
.vscode/
/docs/开发计划/
/docs/配置模板/

# realm 的官方 musl 静态二进制(各约 5-7MB,由 scripts/fetch-realm.sh 拉取)
assets/realm/realm-linux-*
# 出站网络探测的辅助程序(各约 3MB,由 scripts/build-probe.sh 从本仓库构建)
assets/probe/litebox-probe-linux-*
